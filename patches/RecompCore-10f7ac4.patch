+
+void PlatformWin32::ReleaseCursor()
+{
+  if (!m_cursor_locked)
+    return;
+  ClipCursor(nullptr);
+  m_cursor_locked = false;
+  m_clip_rect = {};
+}
+
+void PlatformWin32::UpdateCursorLock()
+{
+  const bool active = GetForegroundWindow() == m_hwnd && !IsIconic(m_hwnd);
+  m_window_focus = active;
+  if (!Config::Get(Config::MAIN_LOCK_CURSOR) || !active || m_in_menu || m_in_size_move ||
+      Core::GetState(Core::System::GetInstance()) == Core::State::Paused)
+  {
+    ReleaseCursor();
+    return;
+  }
+
+  RECT rc{};
+  if (!GetClientRect(m_hwnd, &rc) || rc.right <= rc.left || rc.bottom <= rc.top)
+    return;
+  POINT corners[2] = {{rc.left, rc.top}, {rc.right, rc.bottom}};
+  MapWindowPoints(m_hwnd, nullptr, corners, 2);
+  const RECT screen{corners[0].x, corners[0].y, corners[1].x, corners[1].y};
+  // Windows drops the clip whenever another window takes over, so re-apply it each pass
+  // rather than only when the rectangle changes.
+  if (!m_cursor_locked || !EqualRect(&screen, &m_clip_rect) || !GetClipCursor(&rc) ||
+      !EqualRect(&rc, &screen))
+  {
+    ClipCursor(&screen);
+    m_clip_rect = screen;
+  }
+  if (!m_cursor_locked)
+  {
+    m_cursor_locked = true;
+    SetCursor(nullptr);
+  }
+}
