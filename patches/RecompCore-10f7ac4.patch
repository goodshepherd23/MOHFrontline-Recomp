+void PlatformWin32::LoadNewestState()
+{
+  const std::vector<std::filesystem::path> states =
+      State::Layout::List(StringToPath(File::GetUserPath(D_STATESAVES_IDX)));
+  if (!states.empty())  // List() puts the newest first
+    State::LoadAs(Core::System::GetInstance(), PathToString(states.front()));
