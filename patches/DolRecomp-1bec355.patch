+// --semantics fast: arithmetic FP ops become plain host double math (single ops
+// rounded to float and mirrored into ps1, as the hardware does) instead of the
+// exact helpers. FPSCR status/FPRF are not maintained and products are not
+// rounded to 25 bits -- the same trade Dolphin's JIT makes.
+static int g_fast_fp = 0;
+
+void emit_set_fast_fp(int enabled) {
+    g_fast_fp = enabled != 0;
+}
+
+// Sparse entries (DOLRECOMP_C_SPARSE_ENTRIES=1, local change): program-wide
+// addresses execution can be dispatched to (program entry, symbols, every direct
+// branch target, code pointers found in data), sorted. When set, a chunk's
+// entry switch only gets cases for these plus its own block leaders and return
+// addresses instead of every instruction. With fewer ways into the middle of a
+// block, clang can keep guest values in registers across instructions. Any
+// other address still works: it runs one instruction through the interpreter
+// (ppc_fallback_instruction) and dispatches again, as the LLVM backend's
+// cold-entry path does. Written once before the worker pool starts.
+static const u32* g_entry_points = NULL;
+static u32 g_entry_point_count = 0;
+
+void emit_set_entry_points(const u32* points, u32 count) {
+    g_entry_points = count ? points : NULL;
+    g_entry_point_count = count;
+}
+
+static bool is_global_entry(u32 address) {
+    u32 lo = 0, hi = g_entry_point_count;
+    while (lo < hi) {
+        u32 mid = lo + (hi - lo) / 2u;
+        if (g_entry_points[mid] < address)
+            lo = mid + 1u;
+        else
+            hi = mid;
+    }
+    return lo < g_entry_point_count && g_entry_points[lo] == address;
+}
+
+// Emits the fast form of an arithmetic FP op; false means "use the exact helper".
+static bool emit_fast_fp(FILE* out, const PPCInst* inst) {
+    if (!g_fast_fp)
+        return false;
+    const char* expr = NULL;
+    char buf[160];
+    bool single = false;
+    bool negate = false;
+    switch (inst->op) {
+    case PPC_OP_FADDS: single = true; /* fall through */
+    case PPC_OP_FADD:
+        snprintf(buf, sizeof(buf), "ctx->fpr[%u] + ctx->fpr[%u]", inst->rA, inst->rB);
+        expr = buf;
+        break;
+    case PPC_OP_FSUBS: single = true; /* fall through */
+    case PPC_OP_FSUB:
+        snprintf(buf, sizeof(buf), "ctx->fpr[%u] - ctx->fpr[%u]", inst->rA, inst->rB);
+        expr = buf;
+        break;
+    case PPC_OP_FMULS: single = true; /* fall through */
+    case PPC_OP_FMUL:
+        snprintf(buf, sizeof(buf), "ctx->fpr[%u] * ctx->fpr[%u]", inst->rA, inst->rC);
+        expr = buf;
+        break;
+    case PPC_OP_FDIVS: single = true; /* fall through */
+    case PPC_OP_FDIV:
+        snprintf(buf, sizeof(buf), "ctx->fpr[%u] / ctx->fpr[%u]", inst->rA, inst->rB);
+        expr = buf;
+        break;
+    case PPC_OP_FNMADDS: negate = true; /* fall through */
+    case PPC_OP_FMADDS: single = true;
+        snprintf(buf, sizeof(buf), "ctx->fpr[%u] * ctx->fpr[%u] + ctx->fpr[%u]",
+                 inst->rA, inst->rC, inst->rB);
+        expr = buf;
+        break;
+    case PPC_OP_FNMSUBS: negate = true; /* fall through */
+    case PPC_OP_FMSUBS: single = true;
+        snprintf(buf, sizeof(buf), "ctx->fpr[%u] * ctx->fpr[%u] - ctx->fpr[%u]",
+                 inst->rA, inst->rC, inst->rB);
+        expr = buf;
+        break;
+    case PPC_OP_FNMADD: negate = true; /* fall through */
+    case PPC_OP_FMADD:
+        snprintf(buf, sizeof(buf), "ctx->fpr[%u] * ctx->fpr[%u] + ctx->fpr[%u]",
+                 inst->rA, inst->rC, inst->rB);
+        expr = buf;
+        break;
+    case PPC_OP_FNMSUB: negate = true; /* fall through */
+    case PPC_OP_FMSUB:
+        snprintf(buf, sizeof(buf), "ctx->fpr[%u] * ctx->fpr[%u] - ctx->fpr[%u]",
+                 inst->rA, inst->rC, inst->rB);
+        expr = buf;
+        break;
+    case PPC_OP_FRSP:
+        single = true;
+        snprintf(buf, sizeof(buf), "ctx->fpr[%u]", inst->rB);
+        expr = buf;
+        break;
+    default:
+        return false;
+    }
+    fprintf(out, "    {\n");
+    fprintf(out, "        f64 r = %s;\n", expr);
+    if (negate)
+        fprintf(out, "        if (r == r) r = -r;\n");
+    if (single)
+        fprintf(out, "        r = (f64)(f32)r;\n        ctx->fpr[%u] = ctx->ps1[%u] = r;\n",
+                inst->rD, inst->rD);
+    else
+        fprintf(out, "        ctx->fpr[%u] = r;\n", inst->rD);
+    fprintf(out, "    }\n");
+    if (inst->rc) emit_set_cr1_from_fpscr(out);
+    return true;
+}
